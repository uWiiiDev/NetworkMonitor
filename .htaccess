# NetworkMonitor - Apache Security Configuration (.htaccess)
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always unset X-Powered-By
</IfModule>

# Sensible System-, Datenbank-, Konfigurations- und interne PHP-Dateien sperren
<FilesMatch "(^\.|^config\.php$|^cli_scan\.php$|^router\.php$|^database\.sql$|^VERSION$|\.(sqlite|sqlite3|db|log|json|md|sh|deb|bak|sql)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(data|includes|packaging|\.git)(/|$) - [F,L]
</IfModule>
